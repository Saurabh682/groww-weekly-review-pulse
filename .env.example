# Groww Weekly Review Pulse Environment Template
# Copy this file to .env and fill in your values. NEVER commit .env to version control.

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Recipient for Gmail drafts)
PULSE_EMAIL_TO=your_email@example.com

# MCP Connector Endpoints (configured via host or local stdio)
# Note: Google credentials must live inside the MCP server/host, NOT in this application.
MCP_DOCS_SERVER_COMMAND=
MCP_GMAIL_SERVER_COMMAND=

# Safety / Automation guards (automated collection is disabled by default)
ALLOW_AUTOMATED_PLAY_COLLECTION=false
