# Groww Weekly Review Pulse Environment Template
# Copy this file to .env and fill in your values. NEVER commit .env to version control.

# LLM Provider Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEY=your_gemini_api_key_here

# Email Configuration (Recipient for Gmail drafts)
PULSE_EMAIL_TO=your_email@example.com

# MCP Connector Endpoints (configured via host or local stdio)
# Note: Google credentials must live inside the MCP server/host, NOT in this application.
GMAIL_DOCS_MCP_URL=https://your-mcp-server.example/api/mcp
GMAIL_DOCS_MCP_TOKEN=your_mcp_bearer_token_here

# Store backend: sqlite (local, data/pulse.db) or supabase (needs SUPABASE_DB_URL)
PULSE_STORE=sqlite
SUPABASE_DB_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# Operator auth for write endpoints (Supabase Auth JWT). Set SUPABASE_JWT_SECRET for HS256
# projects, or leave it empty to verify against SUPABASE_URL's JWKS signing keys.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_JWT_SECRET=
OPERATOR_EMAILS=operator@example.com

# Backfill dispatch to GitHub Actions (fine-grained token with Actions: write on this repo only)
GITHUB_REPOSITORY=owner/repo
GITHUB_DISPATCH_TOKEN=
GITHUB_DISPATCH_REF=main

# Dashboard origins allowed to call the API
CORS_ORIGINS=http://localhost:5173
